# System Execution Mode
# Determines whether the application runs in 'development' or 'production' mode
NODE_ENV=production

# Backend Server Port
# Defines the HTTP port the API server will listen on
PORT=5000

# Security Configuration
# Secret key used for signing and verifying JSON Web Tokens (JWT)
# IMPORTANT: Use a strong, random, and unique string in production
JWT_SECRET=replace_here_with_a_highly_secure_random_string

# Sentry DSN for Backend
SENTRY_DSN=

# Database Configuration
# Absolute or relative path to the SQLite database file
# For Railway: set to /data/database.sqlite (persistent volume mount)
DB_PATH=./database.sqlite

# Application Mode
# 'demo'  → blocks all POST/PUT/PATCH/DELETE mutations (Vercel parked mode)
# 'live'  → enables full CRUD operations (Railway production)
APP_MODE=live

# =======================================================
# Client / Frontend Variables (Vite - must prefix with VITE_)
# =======================================================

# API Base URL for the frontend application
# e.g., 'http://localhost:5000/api' or 'https://api.yourdomain.com/api'
VITE_API_BASE_URL=http://localhost:5000/api

# Parked / Read-Only Demo Mode
# If true, specific frontend mutation actions will appear disabled
VITE_DEMO_ENABLED=true

# Sentry DSN for Frontend
VITE_SENTRY_DSN=
